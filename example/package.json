{
  "name": "RetenoSdkExample",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:build:fix": "cd android && ./gradlew --stop && ./gradlew assembleRelease",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "pods": "pod-install --quiet",
    "ios:testflight": "cd ios && bundle exec fastlane ios upload_testflight",
    "port-reverse": "adb reverse tcp:8081 tcp:8081",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-firebase/app": "^26.3.3",
    "@react-native-firebase/messaging": "^26.3.3",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "@react-native/new-app-screen": "0.86.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^4.1.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  }
}
